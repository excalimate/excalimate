{
  "name": "@excalimate/animation-core",
  "version": "0.5.0-rc.1",
  "license": "MIT",
  "description": "Browser-neutral deterministic animation runtime and managed-action compiler for Excalimate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/excalimate/excalimate.git",
    "directory": "packages/animation-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "benchmark": "node ./benchmarks/playback.mjs && node ./benchmarks/auto-animate.mjs && node ./benchmarks/scene-diff.mjs",
    "benchmark:scene-diff": "node ./benchmarks/scene-diff.mjs"
  },
  "dependencies": {
    "@excalimate/project-schema": "^0.5.0-rc.1"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
