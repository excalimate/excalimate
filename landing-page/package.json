    "@mantine/form": "8.3.17",
    "@mantine/hooks": "8.3.17",
    "@mantine/notifications": "8.3.17",
    "@tabler/icons-react": "3.40.0",
    "astro": "^7.1.3",
    "jose": "^6.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260711.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
